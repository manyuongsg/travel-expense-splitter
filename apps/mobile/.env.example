# Expo public variables — copy to .env and fill in values
# EXPO_PUBLIC_ prefix is required for Expo to expose them to the JS bundle

# Optional: override API base URL (auto-detected via Expo hostUri in dev)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8080

# Google OAuth Web Client ID (get from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=